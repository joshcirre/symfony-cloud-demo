{% extends 'base.html.twig' %}

{% block title %}Show Finder — Symfony UX Live Components{% endblock %}

{% block body %}
    <main class="page">
        <header class="hero">
            <p class="eyebrow"><span>Symfony, running on Laravel Cloud</span></p>
            <h1>Show Finder</h1>
            <p class="tagline">
                Yes — this is a <strong>Symfony</strong> app, and it's deployed on <strong>Laravel Cloud</strong>.
                Search thousands of TV shows in real time, every keystroke rendered on the server.
            </p>
        </header>

        {{ component('ShowSearch') }}

        <footer class="footer">
            <p>
                A <a href="https://symfony.com/bundles/ux-live-component/current/index.html" target="_blank" rel="noopener">Symfony</a> app
                deployed on <a href="https://cloud.laravel.com" target="_blank" rel="noopener">Laravel Cloud</a>
                · Data from <a href="https://www.tvmaze.com/api" target="_blank" rel="noopener">TVMaze</a>
            </p>
        </footer>
    </main>
{% endblock %}
