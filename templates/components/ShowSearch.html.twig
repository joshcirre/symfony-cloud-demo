{# Live component: a debounced search box over the TVMaze API #}
<div {{ attributes }} class="show-search">
    <div class="search-bar">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input
            type="search"
            name="query"
            value="{{ query }}"
            data-model="debounce(300)|query"
            placeholder="Search for a TV show…"
            autocomplete="off"
            autofocus
            class="search-input"
        >
        <span class="spinner" data-loading aria-label="Loading"></span>
    </div>

    {% set shows = this.shows %}

    {% if query|trim|length >= 2 %}
        <p class="result-count" data-loading="hide">
            {{ shows|length }} result{{ shows|length == 1 ? '' : 's' }} for “{{ query }}”
        </p>
    {% endif %}

    <div class="results">
        {% for show in shows %}
            <article class="card">
                <div class="poster">
                    {% if show.image %}
                        <img src="{{ show.image }}" alt="{{ show.name }} poster" loading="lazy">
                    {% else %}
                        <div class="poster-placeholder">No image</div>
                    {% endif %}
                    {% if show.rating %}
                        <span class="rating">★ {{ show.rating }}</span>
                    {% endif %}
                </div>
                <div class="card-body">
                    <h2 class="card-title">
                        {% if show.url %}
                            <a href="{{ show.url }}" target="_blank" rel="noopener">{{ show.name }}</a>
                        {% else %}
                            {{ show.name }}
                        {% endif %}
                    </h2>
                    <p class="meta">
                        {% if show.premiered %}<span>{{ show.premiered|slice(0, 4) }}</span>{% endif %}
                        {% if show.network %}<span>{{ show.network }}</span>{% endif %}
                        {% if show.status %}<span class="status status--{{ show.status|lower }}">{{ show.status }}</span>{% endif %}
                    </p>
                    {% if show.genres is not empty %}
                        <ul class="genres">
                            {% for genre in show.genres %}<li>{{ genre }}</li>{% endfor %}
                        </ul>
                    {% endif %}
                    {% if show.summary %}
                        <p class="summary">{{ show.summary|striptags|slice(0, 220) }}{{ show.summary|striptags|length > 220 ? '…' }}</p>
                    {% endif %}
                </div>
            </article>
        {% else %}
            {% if query|trim|length >= 2 %}
                <div class="empty" data-loading="hide">
                    <p>No shows found for “{{ query }}”.</p>
                    <p class="empty-hint">Try another title.</p>
                </div>
            {% else %}
                <div class="empty">
                    <p>Start typing to search thousands of TV shows.</p>
                    <p class="empty-hint">Powered by the TVMaze API — no API key required.</p>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>
