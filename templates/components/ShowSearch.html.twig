{# Live component: a debounced search box over the TVMaze API #}
<div {{ attributes }} class="show-search">
    <div class="search-bar">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input
            type="search"
            name="query"
            value="{{ query }}"
            data-model="debounce(300)|query"
            placeholder="Search for a TV show…"
            autocomplete="off"
            autofocus
            class="search-input"
        >
        <span class="spinner" data-loading aria-label="Loading"></span>
    </div>

    {% set shows = this.shows %}

    {# data-loading toggles the `is-loading` class on this wrapper during a request.
       A class toggle is morph-safe (idiomorph resets the class from the server HTML);
       toggling inline display directly on the grids is not. CSS below drives what shows. #}
    <div class="results-area" data-loading="addClass(is-loading)">
        {% if query|trim|length >= 2 %}
            <p class="result-count">
                {{ shows|length }} result{{ shows|length == 1 ? '' : 's' }} for “{{ query }}”
            </p>
        {% endif %}

        {# Skeleton placeholder — shown via CSS only while .results-area.is-loading #}
        <div class="results skeleton-grid" aria-hidden="true">
            {% for i in 1..10 %}
                <div class="skeleton-card">
                    <div class="sk skeleton-poster"></div>
                    <div class="skeleton-body">
                        <div class="sk skeleton-line" style="width: 70%"></div>
                        <div class="sk skeleton-line" style="width: 45%"></div>
                        <div class="sk skeleton-line skeleton-line--sm" style="width: 90%"></div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="results results-live">
        {% for show in shows %}
            <a class="card" href="{{ show.id ? path('app_show', { id: show.id }) : '#' }}">
                <div class="poster">
                    {% if show.image %}
                        <img src="{{ show.image }}" alt="{{ show.name }} poster" loading="lazy">
                    {% else %}
                        <div class="poster-placeholder">No image</div>
                    {% endif %}
                    {% if show.rating %}
                        <span class="rating">★ {{ show.rating }}</span>
                    {% endif %}
                </div>
                <div class="card-body">
                    <h2 class="card-title">{{ show.name }}</h2>
                    <p class="meta">
                        {% if show.premiered %}<span>{{ show.premiered|slice(0, 4) }}</span>{% endif %}
                        {% if show.network %}<span>{{ show.network }}</span>{% endif %}
                        {% if show.status %}<span class="status status--{{ show.status|lower|replace({' ': '-'}) }}">{{ show.status }}</span>{% endif %}
                    </p>
                    {% if show.genres is not empty %}
                        <ul class="genres">
                            {% for genre in show.genres %}<li>{{ genre }}</li>{% endfor %}
                        </ul>
                    {% endif %}
                    {% if show.summary %}
                        <p class="summary">{{ show.summary|striptags|slice(0, 220) }}{{ show.summary|striptags|length > 220 ? '…' }}</p>
                    {% endif %}
                </div>
            </a>
        {% else %}
            {% if query|trim|length >= 2 %}
                <div class="empty">
                    <p>No shows found for “{{ query }}”.</p>
                    <p class="empty-hint">Try another title.</p>
                </div>
            {% else %}
                <div class="empty">
                    <p>Start typing to search thousands of TV shows.</p>
                    <p class="empty-hint">Powered by the TVMaze API — no API key required.</p>
                </div>
            {% endif %}
        {% endfor %}
        </div>
    </div>
</div>
